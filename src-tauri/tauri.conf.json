{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pgrustore",
  "version": "0.1.0",
  "identifier": "com.pgrustore.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pgrustore",
        "width": 342,
        "height": 626,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "dialog:default",
            "dialog:allow-open"
          ]
        }

      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["backup"],
        "description": "postgresql backup file",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }

}
