{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pgrustore",
  "version": "1.0.16",
  "identifier": "com.pgrustore.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PG_RUSTORE",
        "width": 342,
        "height": 626,
        "resizable": false,
        "fullscreen": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "dialog:default",
            "dialog:allow-open",
            "updater:default"
          ]
        }
      ]
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZENDBFNzU2QzJBMDAwQkUKUldTK0FLRENWdWRBYlhJT1pZVU5pSjlha3VmaktKSWJhT3FaT3Y0WW1QU3BMUWJNTFpEWXNKcDgK",
      "endpoints": [
        "https://github.com/RolandoHidalgo/pg-rustore/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "backup"
        ],
        "description": "postgresql backup file",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}